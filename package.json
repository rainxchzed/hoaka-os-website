{
  "name": "hoaka-os-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview --port 4173 --outDir dist",
    "typecheck": "tsc -b --noEmit",
    "stills": "node scripts/stills.mjs"
  },
  "dependencies": {
    "@fontsource-variable/montserrat": "^5.2.5",
    "@fontsource-variable/onest": "^5.2.5",
    "lenis": "^1.2.3",
    "lucide-react": "^1.47.0",
    "motion": "^12.6.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.5.0",
    "react-router-dom": "^7.5.0",
    "three": "^0.175.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.1",
    "@types/three": "^0.175.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright-core": "^1.63.0",
    "typescript": "^5.8.3",
    "vite": "^6.2.5"
  }
}
